classDiagram
    %% Simplified Class Diagram - Core Architecture

    %% ============================================
    %% Core Data Models
    %% ============================================

    class User {
        -user_id: string
        -email: string
        -password_hash: string
        -name: string
    }

    class Session {
        -session_id: string
        -user_id: string
        -filepath: string
        -status: string
    }

    class GeneticResults {
        -session_id: string
        -findings_encrypted: List
        -summary: Dict
    }

    class Questionnaire {
        -session_id: string
        -answers: Dict
        -diet_type: string
        -health_goals: List
    }

    class Recommendations {
        -session_id: string
        -recommendations: Dict
    }

    %% ============================================
    %% Core Services
    %% ============================================

    class GeneticParser {
        +analyze_all() List
        +get_nutrient_radar_data() List
    }

    class Database {
        +sessions: Collection
        +users: Collection
        +genetic_results: Collection
    }

    class APIBlueprint {
        <<routes>>
        +POST /api/auth/login
        +POST /api/upload
        +POST /api/analyze
        +GET /api/recommendations
        +POST /api/generate-meal-plan
    }

    class AIMealPlanner {
        <<service>>
        +generate_meal_plan() Dict
    }

    %% ============================================
    %% Frontend (Simplified)
    %% ============================================

    class LandingPage {
        <<page>>
    }

    class AnalysisPage {
        <<page>>
        -sessionId: string
        -recommendations: any
    }

    %% ============================================
    %% Key Relationships
    %% ============================================

    User "1" --> "n" Session : owns
    Session "1" --> "1" GeneticResults : has
    Session "1" --> "1" Questionnaire : has
    Session "1" --> "1" Recommendations : has

    Database --> User : stores
    Database --> Session : stores
    Database --> GeneticResults : stores

    GeneticParser --> GeneticResults : generates

    APIBlueprint --> Database : uses
    APIBlueprint --> GeneticParser : uses
    APIBlueprint --> AIMealPlanner : uses

    AIMealPlanner --> Recommendations : uses
    AIMealPlanner --> GeneticResults : uses
    AIMealPlanner --> Questionnaire : uses

    LandingPage ..> APIBlueprint : authenticate
    AnalysisPage ..> APIBlueprint : upload & analyze
    AnalysisPage ..> APIBlueprint : generate meal plan
