# Nutrigenomics API Environment Variables
# Copy this to .env and fill in your values

# Flask settings
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# MongoDB settings
# Local development
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=nutrigenomics

# Production MongoDB with TLS (uncomment and configure for production)
# MONGODB_URI=mongodb://username:password@host:27017/nutrigenomics?tls=true&authSource=admin
# MONGODB_TLS_CA_FILE=/path/to/ca-certificate.pem

# Encryption key for genetic data (CRITICAL!)
# Generate with: python app/encryption.py
# Or: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# SECURITY NOTES:
# - All uploaded genetic data files are automatically encrypted with this key
# - Losing this key means you CANNOT decrypt existing data
# - Back up this key securely in production
# - Rotate keys annually for best security

# Groq API for AI-powered meal planning
# Get your free key from: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Email settings for verification codes
# For Gmail: Enable 2FA and create an App Password at https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
